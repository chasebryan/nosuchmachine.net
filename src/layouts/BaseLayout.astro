---
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "No Such Machine",
  description = "Independent work by Chase Bryan. Currently building Orange, a mathematical language for cryptography with an exact reference evaluator.",
} = Astro.props;
const pageTitle =
  title === "No Such Machine"
    ? "No Such Machine — Chase Bryan"
    : `${title} · No Such Machine`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const isNotFound = Astro.url.pathname.replace(/\/$/, "") === "/404";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f3ed" />
    <meta name="description" content={description} />
    <meta name="author" content="Chase Bryan" />
    <meta property="og:site_name" content="No Such Machine" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/brand/social.png", Astro.site).toString()}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Orange, a mathematical language for cryptography. Independent work by Chase Bryan at No Such Machine." />
    <meta name="twitter:card" content="summary_large_image" />
    {isNotFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/site-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="No Such Machine, home">
        <span class="brand-symbol" aria-hidden="true"></span>
        <span>No Such Machine</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/#work">Orange</a>
        <a href="/book/" aria-current={Astro.url.pathname.startsWith("/book/") ? "location" : undefined}>Book</a>
        <a href="/#about">About</a>
        <a
          class="nav-github"
          href="https://github.com/chasebryan"
          rel="noopener noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer shell">
      <div>
        <a class="footer-name" href="/">
          No Such Machine
        </a>
        <p>Independent research & engineering by Chase Bryan.</p>
      </div>
      <div class="footer-links">
        <a href="https://github.com/chasebryan/nosuchmachine.net">
          Site source
        </a>
        <span>© {new Date().getUTCFullYear()} Chase Bryan</span>
      </div>
    </footer>
  </body>
</html>
