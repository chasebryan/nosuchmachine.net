---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  theme?: "home" | "orange";
}

const {
  title = "No Such Machine",
  description = "No Such Machine — selected work by Chase Bryan, starting with Orange.",
  ogImage = "/brand/mark.svg",
  theme = "home",
} = Astro.props;

const pageTitle =
  title === "No Such Machine" ? "No Such Machine" : `${title} · No Such Machine`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const themeColor = theme === "orange" ? "#f54f1f" : "#b7d0d6";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />
    <meta name="author" content="Chase Bryan" />
    <meta property="og:site_name" content="No Such Machine" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/mark.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[theme === "orange" && "theme-orange"]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="nav-mark" href="/">No Such Machine</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/projects/orange/">Orange</a>
        <a href="https://github.com/chasebryan" rel="noopener noreferrer"
          >GitHub</a
        >
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="shell">
        <span>No Such Machine · Chase Bryan</span>
        <span>
          <a href="https://github.com/chasebryan/nosuchmachine.net">Source</a>
          · AGPL-3.0
        </span>
      </div>
    </footer>
  </body>
</html>
