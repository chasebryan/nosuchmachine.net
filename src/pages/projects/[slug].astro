---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProject, projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect("/");
}

const isOrange = project.slug === "orange";
---

<BaseLayout
  title={project.name}
  description={project.summary}
  ogImage={project.visual.src}
  theme={isOrange ? "orange" : "home"}
>
  <main id="main" class:list={[isOrange && "orange-page"]}>
    <section class="orange-hero" aria-labelledby="project-title">
      <div class="orange-field" aria-hidden="true"></div>
      <div class="shell">
        <div class="orange-copy">
          <p class="orange-eyebrow">{project.status}</p>
          <h1 id="project-title">{project.name}</h1>
          <p class="orange-tagline">{project.tagline}</p>
          <div class="hero-actions">
            {
              project.links.map((link) => (
                <a
                  class={`button ${link.primary ? "button-primary" : "button-ghost"}`}
                  href={link.href}
                  rel="noopener noreferrer"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="orange-visual">
          <img
            src={project.visual.src}
            alt={project.visual.alt}
            width="400"
            height="400"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="orange-body" aria-labelledby="about-orange">
      <div class="shell">
        <h2 id="about-orange">Cryptography you can check</h2>
        <p>{project.summary}</p>
        <p>
          A serious cryptographic library carries several meanings at once: the
          mathematics it is meant to compute, the code that runs on real
          machines, the security properties it claims, and the evidence behind
          those claims. Today those meanings usually live in different tools.
          Orange aims to make the crossings part of the product — one language,
          narrowly worded claims, and evidence you can replay.
        </p>
        <p>
          Orange is pre-alpha and built by one person. The compiler checks and
          evaluates a typed fragment of the language. It does not yet generate
          native code or check proofs, and nothing in the repository has been
          independently reviewed or formally verified.
        </p>

        <div class="orange-paths" aria-label="Paths into Orange">
          {
            project.links.map((link) => (
              <a class="orange-path" href={link.href} rel="noopener noreferrer">
                <span class="orange-path-label">{link.label}</span>
                <span class="orange-path-hint">
                  {link.label === "Repository" &&
                    "Source, fixtures, and toolchain"}
                  {link.label === "The Orange Book" &&
                    "Living reader guide for the design"}
                  {link.label === "Orange School" &&
                    "Competency path into the language"}
                </span>
              </a>
            ))
          }
        </div>

        <p class="orange-back">
          <a href="/">← No Such Machine</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
