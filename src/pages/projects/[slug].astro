---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProject, projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={project.name}
  description={project.summary}
  ogImage={project.visual.src}
  theme="orange"
>
  <main id="main" class="or">
    <aside class="or-spine" aria-hidden="true">
      <img src="/projects/orange/emblem.svg" alt="" width="48" height="48" />
      <span>Orange</span>
    </aside>

    <article class="or-sheet">
      <header class="or-mast">
        <p class="or-kicker">{project.status}</p>
        <h1 id="project-title">{project.name}</h1>
        <p class="or-deck">{project.tagline}</p>
      </header>

      <figure class="or-specimen">
        <figcaption>Specimen — SHA-256 helpers the compiler already accepts</figcaption>
        <pre><code>{`edition 2026;
module sha256 {
  spec choose(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] {
    (x & y) ^ (~x & z)
  }
  spec majority(x: Word[32], y: Word[32], z: Word[32]) -> Word[32] {
    (x & y) ^ (x & z) ^ (y & z)
  }
}`}</code></pre>
      </figure>

      <section class="or-prose" aria-labelledby="about-orange">
        <h2 id="about-orange">Why it exists</h2>
        <p>{project.summary}</p>
        <p>
          Specifications, fast implementations, claimed properties, and evidence
          usually live in different tools. Orange keeps those crossings inside
          one language — claims with subjects and assumptions, evidence you can
          replay, and (eventually) native code with a stable ABI.
        </p>
        <p>
          Pre-alpha, solo-built. The compiler checks and evaluates a typed
          fragment. It does not yet generate native code or check proofs. Nothing
          here has been independently reviewed or formally verified.
        </p>
      </section>

      <section class="or-sources" aria-labelledby="sources-title">
        <div class="or-sources-head">
          <h2 id="sources-title">Sources</h2>
          <img
            class="or-book"
            src={project.visual.src}
            alt={project.visual.alt}
            width="120"
            height="120"
            decoding="async"
          />
        </div>
        <ol>
          {
            project.links.map((link, i) => (
              <li>
                <span class="or-num">{String(i + 1).padStart(2, "0")}</span>
                <a href={link.href} rel="noopener noreferrer">
                  <strong>{link.label}</strong>
                  <span>
                    {link.label === "Repository" &&
                      "Source, fixtures, and toolchain"}
                    {link.label === "The Orange Book" &&
                      "Living reader guide for the design"}
                    {link.label === "Orange School" &&
                      "Competency path into the language"}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <p class="or-back">
        <a href="/">Return to No Such Machine</a>
      </p>
    </article>
  </main>
</BaseLayout>
