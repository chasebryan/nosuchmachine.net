---
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProjects } from "../data/projects";

const orange = featuredProjects[0];
---

<BaseLayout>
  <main id="main">
    <section class="hero" aria-labelledby="brand-title">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="hero-grain" aria-hidden="true"></div>
      <div class="hero-content">
        <div class="brand-lockup">
          <h1 class="brand-name" id="brand-title">No Such Machine</h1>
          <p class="brand-domain">nosuchmachine.net</p>
        </div>
        <p class="hero-lede">
          A selected portfolio of ambitious work — exact systems, cryptography,
          and evidence you can inspect.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button button-primary" href="#work">See the work</a>
          {
            orange && (
              <a class="button button-ghost" href={`/projects/${orange.slug}`}>
                Featured: {orange.name}
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="section featured" id="work" aria-labelledby="work-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">Selected work</p>
          <h2 id="work-title">Projects chosen for ambition, not volume.</h2>
          <p>
            This site grows as entries earn a place. Orange is the first —
            and currently the only — featured project.
          </p>
        </header>

        {
          orange && (
            <article
              class="project-feature"
              style={`--project-accent: ${orange.accent}`}
              aria-labelledby="orange-title"
            >
              <div class="project-copy">
                <p class="project-status">{orange.status}</p>
                <h3 id="orange-title">{orange.name}</h3>
                <p class="project-tagline">{orange.tagline}</p>
                <p class="project-summary">{orange.summary}</p>
                <div class="project-links">
                  <a href={`/projects/${orange.slug}`}>Open project page</a>
                  {orange.links.map((link) => (
                    <a href={link.href} rel="noopener noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
              <div class="project-visual">
                <img
                  src={orange.visual.src}
                  alt={orange.visual.alt}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </article>
          )
        }
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="shell">
        <header class="section-head">
          <p class="eyebrow">About</p>
          <h2 id="about-title">Built for selection, not a dump of every repo.</h2>
          <p>
            No Such Machine is Chase Bryan's public portfolio surface. New
            projects land here only when they belong in the showcase. The
            catalog is intentionally small.
          </p>
        </header>
        <p>
          Start with
          {
            orange && (
              <a class="text-link" href={`/projects/${orange.slug}`}>
                Orange
              </a>
            )
          }
          — a language for cryptography you can check — or browse
          <a
            class="text-link"
            href="https://github.com/chasebryan"
            rel="noopener noreferrer">GitHub</a
          >
          for everything else.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
