---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main">
    <section class="hero-home" aria-labelledby="brand-title">
      <div class="hero-atmosphere" aria-hidden="true"></div>
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="hero-content-home">
        <div class="brand-lockup">
          <img
            class="brand-mark"
            src="/brand/mark.svg"
            alt=""
            width="64"
            height="64"
            decoding="async"
          />
          <h1 class="brand-name" id="brand-title">No Such Machine</h1>
          <p class="brand-domain">nosuchmachine.net</p>
        </div>
        <p class="hero-lede">
          Selected work by Chase Bryan — starting with Orange.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button button-primary" href="/projects/orange/">
            Enter Orange
          </a>
          <a
            class="button button-ghost person-link"
            href="https://github.com/chasebryan"
            rel="noopener noreferrer"
          >
            <img
              class="person-avatar"
              src="/brand/chase.jpg"
              alt=""
              width="28"
              height="28"
              decoding="async"
            />
            <span>chasebryan</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
