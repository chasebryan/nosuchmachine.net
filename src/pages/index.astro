---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProject } from "../data/projects";
const orange = getProject("orange")!;
---

<BaseLayout>
  <main id="main">
    <section class="intro shell" aria-labelledby="intro-title">
      <p class="eyebrow">CHASE BRYAN <span aria-hidden="true">/</span> INDEPENDENT WORK</p>
      <div class="intro-grid">
        <h1 id="intro-title">Mathematics,<br />made <em>executable.</em></h1>
        <p class="intro-note">I build languages and tools at the intersection of mathematics and cryptography. My focus is <a href="#work">Orange<span aria-hidden="true"> ↙</span></a>.</p>
      </div>
    </section>
    <section id="work" class="work-section shell" aria-labelledby="orange-title">
      <div class="section-label">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> CURRENT PROJECT</p>
        <span class="section-label-note">LANGUAGE DESIGN & CRYPTOGRAPHY</span>
      </div>
      <div class="orange-feature">
        <div class="orange-copy">
          <div class="project-kicker"><span>OPEN SOURCE</span><span>{orange.status}</span></div>
          <h2 id="orange-title">Orange<span>.</span></h2>
          <p class="orange-tagline">A mathematical language<br class="desktop-break" /> for cryptography.</p>
          <p class="orange-description">Write the specification. Make its meaning explicit. Explore it with a Rust frontend and an exact reference evaluator.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/projects/orange/">Explore Orange <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={orange.githubUrl}>View source <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="orange-artwork" aria-hidden="true">
          <div class="artwork-topline"><span>ORANGE</span><span>01</span></div>
          <img class="orange-emblem" src="/projects/orange/emblem.svg" alt="" width="1024" height="1024" fetchpriority="high" />
          <div class="artwork-bottomline"><span>MATHEMATICAL INTENT.<br />EXECUTABLE FORM.</span><span class="artwork-symbol">↗</span></div>
        </div>
      </div>
      <div class="project-caption">
        <span>A language in development. Built in the open.</span>
        <a href="/book/">Read the Orange Book <span aria-hidden="true">→</span></a>
      </div>
      <div class="principles" aria-label="Inside Orange">
        <div class="principle"><span class="principle-number">01 / SPECIFICATION</span><h3>Start with the mathematics.</h3><p>Typed specifications keep the meaning of a cryptographic idea explicit.</p></div>
        <div class="principle"><span class="principle-number">02 / PRECISION</span><h3>Make the rules clear.</h3><p>Integers, fixed-width words, and modular values each have defined semantics.</p></div>
        <div class="principle"><span class="principle-number">03 / EVALUATION</span><h3>Inspect the result.</h3><p>A deterministic reference evaluator makes specifications executable and inspectable.</p></div>
      </div>
    </section>
    <section id="about" class="about-section shell" aria-labelledby="about-title">
      <div class="about-label"><p class="eyebrow">BEHIND THE WORK</p><span class="about-monogram" aria-hidden="true">cb.</span></div>
      <div class="about-copy">
        <h2 id="about-title">Chase Bryan.</h2>
        <p>I’m interested in how we describe complex systems—and how we make those descriptions precise enough to work with.</p>
        <p>Orange brings that work into focus: mathematics, language design, and cryptography, in one ongoing project.</p>
        <a class="text-link" href="https://github.com/chasebryan">Elsewhere on GitHub <span aria-hidden="true">↗</span></a>
      </div>
      <div class="about-note"><span class="eyebrow">NO SUCH MACHINE</span><p>Independent research.<br />Open source.<br />A work in progress.</p></div>
    </section>
  </main>
</BaseLayout>
