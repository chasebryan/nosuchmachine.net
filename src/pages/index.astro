---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookBlocks from "../components/BookBlocks.astro";
import CodeListing from "../components/CodeListing.astro";
import StatusBadge from "../components/StatusBadge.astro";
import book from "../data/book.json";
import { getProject } from "../data/projects";
import { groupBookRows, loadBookSync, loadCurriculumRows, loadManifestInfo, loadManuscriptRows } from "../lib/book-status";
import { orangeRevision, sha256Fixture, sha256FixturePath } from "../data/orange-sources";
const orange = getProject("orange")!;
const bookInfo = loadManifestInfo();
const curriculumGroups = groupBookRows(loadCurriculumRows(book.chapters));
const manuscriptGroups = groupBookRows(loadManuscriptRows(book.chapters));
const bookSync = loadBookSync();
const sha256FixtureUrl = `https://github.com/chasebryan/orange/blob/${orangeRevision}/${sha256FixturePath}`;
const conformancePath = ["compiler", "crates", "orangec", "tests", "s3b_conformance.rs"];
---

<BaseLayout>
  <main id="main">
    <section id="hero" class="hero shell" aria-labelledby="hero-title">
      <p class="eyebrow">CHASE BRYAN <span aria-hidden="true">/</span> INDEPENDENT WORK</p>
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="hero-kicker">
            <StatusBadge status={orange.status}>{orange.status}</StatusBadge>
            <span class="eyebrow">OPEN SOURCE</span>
          </div>
          <h1 id="hero-title">Orange<span class="hero-dot">.</span></h1>
          <p class="hero-tagline">A mathematical language<br class="desktop-break" /> for cryptography.</p>
          <p class="hero-statement">Mathematics, made <em>executable.</em></p>
          <p class="hero-description">Write the specification. Make its meaning explicit. Explore it with a Rust frontend and an exact reference evaluator.</p>
          <p class="hero-note">I build languages and tools at the intersection of mathematics and cryptography. My focus is <a href="#current">Orange<span aria-hidden="true"> ↙</span></a>.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="/book/">Book <span aria-hidden="true">→</span></a>
            <a class="button button-secondary link-external" href={orange.githubUrl} rel="noopener noreferrer">Source <span class="external-icon" aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="/projects/orange/">Reference <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <figure class="hero-emblem" aria-hidden="true">
          <img src="/projects/orange/emblem.svg" alt="" width="1024" height="1024" fetchpriority="high" />
          <figcaption>MATHEMATICAL INTENT.<br />EXECUTABLE FORM.</figcaption>
        </figure>
      </div>
      <p class="hero-caption">A language in development. Built in the open.</p>
    </section>

    <section id="current" class="band shell" aria-labelledby="current-title">
      <div class="section-label">
        <h2>What works today</h2>
        <span class="section-label-note">LANGUAGE DESIGN & CRYPTOGRAPHY</span>
      </div>
      <h2 id="current-title" class="eyebrow section-kicker"><span class="status-dot" aria-hidden="true"></span> CURRENT PROJECT</h2>
      <div class="principles" aria-label="Inside Orange">
        <div class="principle"><span class="principle-number">01 / SPECIFICATION</span><h3>Start with the mathematics.</h3><p>Typed specifications keep the meaning of a cryptographic idea explicit.</p></div>
        <div class="principle"><span class="principle-number">02 / PRECISION</span><h3>Make the rules clear.</h3><p>Integers, fixed-width words, and modular values each have defined semantics.</p></div>
        <div class="principle"><span class="principle-number">03 / EVALUATION</span><h3>Inspect the result.</h3><p>A deterministic reference evaluator makes specifications executable and inspectable.</p></div>
      </div>
    </section>

    <section id="listing" class="band shell" aria-labelledby="listing-title">
      <div class="section-label">
        <h2 id="listing-title">A checked SHA-256 fragment</h2>
      </div>
      <CodeListing><span slot="caption">Copied from orange {orangeRevision.slice(0, 7)} <a href={sha256FixtureUrl}>{sha256FixturePath.split("/").map((segment, index, parts) => (
        <>
          <span class="code-path-seg">{segment}</span>
          {index < parts.length - 1 && <span class="code-path-sep">/<wbr /></span>}
        </>
      ))}</a></span>{sha256Fixture}</CodeListing>
      <p>{conformancePath.map((segment, index, parts) => (
        <>
          <span class="code-path-seg">{segment}</span>
          {index < parts.length - 1 && <span class="code-path-sep">/<wbr /></span>}
        </>
      ))} evaluates this file and expects sha256::round0_a = 0x5d6aebcd. That is a conformance check of the fixture. It is not native code, a proof, or a security property.</p>
    </section>

    <section id="non-claims" class="band shell" aria-labelledby="non-claims-title">
      <div class="note">
        <p class="eyebrow">PROJECT STATUS / {orange.status.toUpperCase()}</p>
        <h2 id="non-claims-title">What Orange does not claim</h2>
        <ul>
          {orange.limitations.map((limit) => (
            <li>{limit}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="book-parts" class="band shell" aria-labelledby="book-parts-title">
      <div class="section-label">
        <h2 id="book-parts-title">{book.title}</h2>
        <a href="/book/">Read the Orange Book <span aria-hidden="true">→</span></a>
      </div>
      <p>This list is the original 17-chapter manuscript plus appendices, docs/THE_ORANGE_BOOK.md. It is an earlier draft. Those chapter numbers stay until one renumbering pass later. It is not the finished three-part Book.</p>
      <p>Novice, Journeyman, and Master is a separate curriculum in docs/book/, being written now. It is not this list, and it is not complete.</p>
      <BookBlocks
        blockTag="h3"
        variant="cards"
        curriculumGroups={curriculumGroups}
        manuscriptGroups={manuscriptGroups}
        version={bookInfo.version}
        sync={bookSync}
      />
    </section>

    <section id="about" class="about-section shell" aria-labelledby="about-title">
      <div class="about-label"><p class="eyebrow">BEHIND THE WORK</p><span class="about-monogram" aria-hidden="true">cb.</span></div>
      <div class="about-copy">
        <h2 id="about-title">Chase Bryan.</h2>
        <p>I’m interested in how we describe complex systems—and how we make those descriptions precise enough to work with.</p>
        <p>Orange brings that work into focus: mathematics, language design, and cryptography, in one ongoing project.</p>
        <a class="text-link link-external" href="https://github.com/chasebryan" rel="noopener noreferrer">Elsewhere on GitHub <span class="external-icon" aria-hidden="true">↗</span></a>
      </div>
      <div class="about-note"><span class="eyebrow">NO SUCH MACHINE</span><p>Independent research.<br />Open source.<br />A work in progress.</p></div>
    </section>
  </main>
</BaseLayout>
