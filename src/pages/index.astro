---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main id="main" class="home">
    <div class="home-field" aria-hidden="true"></div>

    <h1 class="home-poster" id="brand-title">
      <span class="home-poster-line" data-i="1">No</span>
      <span class="home-poster-line" data-i="2">Such</span>
      <span class="home-poster-line" data-i="3">Machine</span>
    </h1>

    <p class="home-domain">nosuchmachine.net</p>

    <footer class="home-colophon">
      <p class="home-line">
        Selected work by
        <a class="home-person" href="https://github.com/chasebryan" rel="noopener noreferrer">
          <img src="/brand/chase.jpg" alt="" width="36" height="36" decoding="async" />
          <span>Chase Bryan</span>
        </a>
      </p>
      <p class="home-line home-path">
        Begin with
        <a href="/projects/orange/">Orange — cryptography you can check</a>
      </p>
    </footer>
  </main>
</BaseLayout>
