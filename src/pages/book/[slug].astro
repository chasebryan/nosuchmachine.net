---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BookLayout from "../../layouts/BookLayout.astro";
import book from "../../data/book.json";
import study from "../../data/study.json";
export async function getStaticPaths() {
  const manuscripts = await getCollection("book");
  const lessons = await getCollection("study");
  return [...manuscripts, ...lessons].map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<"book"> | CollectionEntry<"study">; }
const { entry } = Astro.props;
const chapter = book.chapters.find((chapter) => chapter.slug === entry.id)
  ?? study.lessons.find((lesson) => lesson.slug === entry.id);
if (!chapter) throw new Error(`Missing book metadata for ${entry.id}`);
const { Content, headings } = await render(entry);
---

<BookLayout chapter={chapter} headings={headings}>
  <Content />
</BookLayout>
