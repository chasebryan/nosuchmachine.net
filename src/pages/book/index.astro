---
import BookLayout from "../../layouts/BookLayout.astro";
import StatusMarker from "../../components/StatusMarker.astro";
import book from "../../data/book.json";
import { groupBookRows, loadBookRows, showContentSlots } from "../../lib/book-status";
const bookGroups = groupBookRows(loadBookRows(book.chapters));
---

<BookLayout>
  <div class="book-introduction">
    <img src="/projects/orange/book-cover.svg" alt="The Orange Book cover: the Orange emblem in cream on an orange field." width="400" height="560" />
    <div>
      <p>The Orange Book explains why Orange exists, what it is intended to become, what has actually been built, and which questions remain open.</p>
      <p class="book-introduction-note">It is not a normative language specification, proof, assurance report, license grant, or release claim.</p>
      <span class="book-edition">Living pre-alpha reader guide</span>
    </div>
  </div>

  {showContentSlots && (
    <h2 class="copy-slot">TODO(content): Novice, Journeyman, Master</h2>
  )}

  {showContentSlots && (
    <section class="book-checks" aria-labelledby="book-checks-title">
      <h2 id="book-checks-title" class="copy-slot">TODO(content): how chapters are checked</h2>
      <p class="copy-slot">TODO(content): checking note</p>
    </section>
  )}

  <p class="book-start">
    <a class="button button-primary" href="/book/preface/">Start reading <span aria-hidden="true">→</span></a>
  </p>

  <section id="book-parts" class="book-contents-list" aria-labelledby="book-contents-title">
    <h2 id="book-contents-title">Inside the book</h2>
    {bookGroups.map((group) => (
      <div class="book-contents-group">
        {group.part && <h3>{group.part}</h3>}
        <ol>
          {group.rows.map((row) => (
            <li data-status={row.status}>
              {row.href ? (
                <a href={row.href}>
                  <span>{row.title}</span>
                  <StatusMarker status={row.status} />
                </a>
              ) : (
                <span>
                  <span>{row.title}</span>
                  <StatusMarker status={row.status} />
                </span>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BookLayout>
