---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not part of the No Such Machine portfolio.">
  <main id="main" class="section" style="min-height:70svh;display:grid;align-content:center;">
    <div class="shell" style="max-width:36rem;display:grid;gap:1rem;">
      <p class="eyebrow">404</p>
      <h1 style="margin:0;font-family:var(--font-display);font-size:clamp(2rem,6vw,3.2rem);letter-spacing:-0.03em;">
        No such page.
      </h1>
      <p style="margin:0;color:var(--ink-soft);">
        The portfolio only lists selected work. Return home and start from there.
      </p>
      <p style="margin:0;">
        <a class="text-link" href="/">Back to No Such Machine</a>
      </p>
    </div>
  </main>
</BaseLayout>
