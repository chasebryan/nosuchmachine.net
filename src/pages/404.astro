---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not part of the No Such Machine portfolio.">
  <main id="main" class="section-simple">
    <div class="shell" style="max-width:34rem;display:grid;gap:1rem;">
      <h1>No such page.</h1>
      <p style="margin:0;color:var(--ink-soft);">
        The portfolio only lists selected work. Return home and start from there.
      </p>
      <p style="margin:0;">
        <a href="/" style="font-family:var(--font-display);font-weight:700;">
          Back to No Such Machine
        </a>
      </p>
    </div>
  </main>
</BaseLayout>
