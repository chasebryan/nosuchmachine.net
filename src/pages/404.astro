---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page is not part of the No Such Machine portfolio.">
  <main id="main" style="min-height:100svh;display:grid;place-content:center;padding:2rem;font-family:var(--font-mono);">
    <div style="display:grid;gap:1rem;max-width:28rem;">
      <h1 style="margin:0;font-family:var(--font-poster);font-size:clamp(2.5rem,10vw,4rem);text-transform:uppercase;line-height:0.9;">
        No such page
      </h1>
      <a href="/" style="color:var(--orange);">Return home</a>
    </div>
  </main>
</BaseLayout>
